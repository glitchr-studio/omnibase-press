{# One quote: the words - as they were said, their translation a click away -, then who said them, what they are, where it was printed (a link when there is one). #}
{% set reading = app.request ? app.request.locale : 'en' %}
{% set role = quote.roleIn(reading) %}
<figure class="press-quote{{ quote.featured ? ' is-featured' }} is-{{ quote.kind.value }}"{% if not quote.translatedIn(reading) and quote.language %} lang="{{ quote.language }}"{% endif %}>
    {% include '@Press/client/_quote_words.html.twig' with {quote: quote, caption: false} %}
    {% if quote.author or role or quote.source %}
    <figcaption>
        {% if quote.author %}<b class="press-quote-author">{{ quote.author }}</b>{% endif %}
        {% if role and role != quote.source %}<span class="press-quote-role">{{ role }}</span>{% endif %}
        {% if quote.source %}<cite class="press-quote-source">{% if quote.url %}<a href="{{ quote.url }}" rel="noopener" target="_blank">{{ quote.source }}</a>{% else %}{{ quote.source }}{% endif %}</cite>{% endif %}
        {% if quote.date %}<time datetime="{{ quote.date|date('Y-m-d') }}">{{ quote.date|format_date('long') }}</time>{% endif %}
        {% if quote.release %}<span class="press-quote-release">{{ '@press.quote.about'|trans({release: quote.release}) }}</span>{% endif %}
    </figcaption>
    {% endif %}
</figure>
